# compiled output
/bin
/pkg
/target
**/target/

# Node.js dependencies and build output (any crate, e.g. crates/trusted-server-js)
**/node_modules/
**/dist/
**/.npm
**/.eslintcache
# Auto-generated JS module index
**/src/generated-modules.ts

# local Spin CLI downloads
/spin
/spin.sig

# EdgeZero local KV store (created by edgezero-adapter-axum framework)
.edgezero/
/dist/prebid/

# env
.env*
trusted-server.toml
# partial copies left if the ts CLI config writer is killed mid-write
.ts-write-*
js-assets.toml

# backup
**/*.rs.bk
src/main_*.rs
src/*.html

# OS
.DS_Store

# IDE
.specstory
.vscode

# Agent implementation worktrees
/.worktrees/

# Claude Code — ignore all, then whitelist shared config
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/skills/

# SSL certificates
*.pem

/guest-profiles
/benchmark-results/**

# Playwright browser tests
/crates/trusted-server-integration-tests/browser/node_modules/
/crates/trusted-server-integration-tests/browser/test-results/
/crates/trusted-server-integration-tests/browser/playwright-report/
/crates/trusted-server-integration-tests/browser/.browser-test-state.json

# Defunct pre-rename crate dirs (renamed to crates/trusted-server-*); ignore the
# leftover local build artifacts (node_modules, target, dist) that remain on disk.
/crates/js/
/crates/integration-tests/

# Operator-owned AWS deployment inputs and state
/deploy/examples/native-aws-workload/**/.terraform/
/deploy/examples/native-aws-workload/**/terraform.tfstate*
/deploy/examples/native-aws-workload/**/.terraform.tfstate.lock.info
/deploy/examples/native-aws-workload/**/*.tfplan
/deploy/examples/native-aws-workload/**/*.tfvars
/deploy/examples/native-aws-workload/**/*.tfvars.json
/deploy/examples/native-aws-workload/**/*.backend.hcl
/deploy/examples/native-aws-workload/**/backend_override.tf

# Documentation proposal workflow scratch space
/.docs-proposal/
