{
  "name": "tsjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trusted Server tsjs TypeScript library with queue and simple banner rendering.",
  "scripts": {
    "build": "node ../../../scripts/browser-build-runner.mjs -- node build-all.mjs",
    "build:trace-assets": "node ../../../scripts/browser-build-runner.mjs -- node build-trace-assets.mjs",
    "build:prebid-external": "node ../../../scripts/browser-build-runner.mjs -- node build-prebid-external.mjs",
    "dev": "node ../../../scripts/browser-build-runner.mjs -- node browser-tools.mjs dev",
    "test": "node ../../../scripts/browser-build-runner.mjs -- node browser-tools.mjs test",
    "test:watch": "node ../../../scripts/browser-build-runner.mjs -- node browser-tools.mjs test:watch",
    "typecheck": "node ../../../scripts/browser-build-runner.mjs -- node browser-tools.mjs typecheck",
    "typecheck:canary": "node ../../../scripts/browser-build-runner.mjs -- node check-two-root-typecheck.mjs",
    "lint": "node ../../../scripts/browser-build-runner.mjs -- node browser-tools.mjs lint",
    "lint:fix": "node ../../../scripts/browser-build-runner.mjs -- node browser-tools.mjs lint:fix",
    "format": "node ../../../scripts/browser-build-runner.mjs -- node browser-tools.mjs format",
    "format:write": "node ../../../scripts/browser-build-runner.mjs -- node browser-tools.mjs format:write"
  },
  "dependencies": {
    "prebid.js": "^10.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
