{
  "name": "tsjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trusted Server tsjs TypeScript library with queue and simple banner rendering.",
  "scripts": {
    "build": "node build-all.mjs",
    "build:prebid-external": "node build-prebid-external.mjs",
    "generate:aps-contract": "node ../../../scripts/generate-aps-renderer-contract.mjs",
    "check:aps-contract": "node ../../../scripts/generate-aps-renderer-contract.mjs --check",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:architecture": "node --test test/eslint/no-adtech-globals.test.mjs",
    "lint": "npm run test:architecture && eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\""
  },
  "dependencies": {
    "prebid.js": "10.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
