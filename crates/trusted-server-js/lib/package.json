{
  "name": "tsjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trusted Server tsjs TypeScript library with queue and simple banner rendering.",
  "scripts": {
    "build": "node build-all.mjs",
    "build:prebid-external": "node build-prebid-external.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0 && npm run lint:crates",
    "lint:crates": "cd ../.. && eslint --max-warnings=0 \"*/*/js/{src,test}/**/*.{ts,tsx,js,mjs}\"",
    "lint:fix": "eslint --fix . --max-warnings=0 && cd ../.. && eslint --fix --max-warnings=0 \"*/*/js/{src,test}/**/*.{ts,tsx,js,mjs}\"",
    "format": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\" && prettier --check \"../../*/*/js/{src,test}/**/*.{ts,tsx,js,mjs,json,css,md}\" \"../../{.prettierrc.json,eslint.config.js,tsconfig.json}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\" && prettier --write \"../../*/*/js/{src,test}/**/*.{ts,tsx,js,mjs,json,css,md}\" \"../../{.prettierrc.json,eslint.config.js,tsconfig.json}\""
  },
  "dependencies": {
    "prebid.js": "^10.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
