        },
        "extensions": {
          "$ref": "#/definitions/extensions"
        }
      }
    },
    "buildReport": {
      "type": "object",
      "required": [
        "declared_class",
        "source_commit",
        "package_version",
        "target",
        "variant"
      ],
      "additionalProperties": false,
      "properties": {
