    "assessmentProtectedHeader": {
      "type": "object",
      "required": ["alg", "kid", "typ"],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "$ref": "#/definitions/base64url32"
        },
        "typ": {
          "const": "ts-publisher-assessment+jws"
        }
