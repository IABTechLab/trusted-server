        },
        "jwk": {
          "$ref": "#/definitions/publicJwk"
        },
        "not_before": {
          "$ref": "#/definitions/time"
        },
        "not_after": {
          "$ref": "#/definitions/time"
        }
      }
    },
    "evidenceProtectedHeader": {
      "type": "object",
      "required": ["alg", "kid", "typ"],
      "additionalProperties": false,
