  "definitions": {
    "text": {
      "type": "string",
      "maxLength": 256
    },
    "nonemptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "time": {
      "$ref": "#/definitions/integer"
    },
    "hex256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$",
      "$comment": "Protocol boundary accepts ASCII DNS only; canonicalize ASCII letters to lowercase, remove one terminal dot, reject invalid DNS syntax and IP literals. Already-encoded xn-- labels are opaque ASCII DNS labels; Unicode input is rejected, with no Unicode/UTS dependency.",
      "not": {
        "pattern": "(?:^|\\.)(?:[0-9]+|0x[0-9a-f]*)$"
      }
    },
    "httpsIdentifier": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?:/[A-Za-z0-9._~-]+)*$",
      "$comment": "Canonical HTTPS identifier (PA-IDENTIFIER): lowercase ASCII host without port, trailing dot or IP literal; optional path of non-empty unreserved-character segments, no trailing slash, no dot segments, no percent-encoding, userinfo, query or fragment. Compared as exact bytes. Host label/total length limits are enforced outside this pattern.",
      "not": {
        "anyOf": [
          {
            "pattern": "^https://(?:[a-z0-9-]+\\.)*(?:[0-9]+|0x[0-9a-f]*)(?:/|$)"
          },
          {
            "pattern": "/\\.\\.?(?:/|$)"
          }
        ]
      }
    },
    "environment": {
      "enum": ["production", "staging", "development"]
    },
    "extensions": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {}
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "$ref": "#/definitions/hex256"
        }
      }
    },
    "publicJwk": {
      "type": "object",
      "required": ["kty", "crv", "x"],
      "additionalProperties": false,
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "$ref": "#/definitions/base64url32"
        }
      }
    },
    "keyValidity": {
      "type": "object",
