    "binding": {
      "type": "object",
      "required": [
        "schema",
        "host",
        "publisher_id",
        "operator_id",
        "deployment_id",
        "environment",
        "platform",
        "attestation_key",
        "configuration",
        "extensions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-binding-v1"
        },
        "host": {
          "$ref": "#/definitions/host"
        },
        "publisher_id": {
          "$ref": "#/definitions/uuid"
        },
        "operator_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/httpsIdentifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployment_id": {
          "$ref": "#/definitions/uuid"
        },
        "environment": {
          "$ref": "#/definitions/environment"
        },
        "platform": {
          "$ref": "#/definitions/platform"
        },
        "attestation_key": {
          "$ref": "#/definitions/keyValidity"
        },
        "configuration": {
          "$ref": "#/definitions/configuration"
        },
        "extensions": {
          "$ref": "#/definitions/extensions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "properties": {
                  "provider": {
                    "const": "axum"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "environment": {
                "const": "development"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "properties": {
                  "provider": {
                    "const": "fastly"
                  },
                  "staging": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "environment": {
                "enum": ["staging", "development"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "properties": {
                  "provider": {
                    "const": "fastly"
                  },
                  "staging": {
                    "const": false
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "environment": {
                "enum": ["production", "development"]
              }
            }
          }
        }
      ]
    },
    "buildReport": {
      "type": "object",
      "required": [
