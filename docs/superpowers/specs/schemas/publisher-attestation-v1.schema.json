    "statusProtectedHeader": {
      "type": "object",
      "required": ["alg", "kid", "typ"],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "$ref": "#/definitions/base64url32"
        },
        "typ": {
          "const": "ts-publisher-status+jws"
        }
      }
    },
    "platform": {
      "type": "object",
      "required": ["provider", "service_id", "service_version", "staging"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": ["fastly", "axum"]
        },
        "service_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonemptyText"
            },
            {
              "type": "null"
            }
          ]
        },
        "service_version": {
          "anyOf": [
            {
              "$ref": "#/definitions/positiveInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "staging": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "fastly"
              }
            }
          },
          "then": {
            "properties": {
              "service_id": {
                "$ref": "#/definitions/nonemptyText"
              },
              "service_version": {
                "$ref": "#/definitions/positiveInteger"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "axum"
              }
            }
          },
          "then": {
            "properties": {
              "service_id": {
                "type": "null"
              },
              "service_version": {
                "type": "null"
              },
              "staging": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
