    "assessment": {
      "type": "object",
      "required": [
        "schema",
        "issuer",
        "assessment_id",
        "enrollment_id",
        "binding",
        "binding_id",
        "evidence_digest",
        "observed_from",
        "observed_until",
        "issued_at",
        "expires_at",
        "policy",
        "result",
        "checks",
        "build",
        "reason_codes",
        "extensions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-assessment-v1"
        },
        "issuer": {
          "$ref": "#/definitions/httpsIdentifier"
        },
        "assessment_id": {
          "$ref": "#/definitions/uuid"
        },
        "enrollment_id": {
          "$ref": "#/definitions/uuid"
        },
        "binding": {
          "$ref": "#/definitions/binding"
        },
        "binding_id": {
          "$ref": "#/definitions/hex256"
        },
        "evidence_digest": {
          "$ref": "#/definitions/digest"
        },
        "observed_from": {
          "$ref": "#/definitions/time"
        },
        "observed_until": {
          "$ref": "#/definitions/time"
        },
        "issued_at": {
          "$ref": "#/definitions/time"
        },
        "expires_at": {
          "$ref": "#/definitions/time"
        },
        "policy": {
          "$ref": "#/definitions/policy"
        },
        "result": {
          "enum": ["satisfied", "not_satisfied", "indeterminate"]
        },
        "checks": {
          "$ref": "#/definitions/checks"
        },
        "build": {
          "$ref": "#/definitions/build"
        },
        "reason_codes": {
          "$ref": "#/definitions/reasonCodes"
        },
        "extensions": {
          "$ref": "#/definitions/extensions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "build": {
                "properties": {
                  "provider_files_hash": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "binding": {
                "properties": {
                  "platform": {
                    "properties": {
                      "provider": {
                        "const": "fastly"
                      },
                      "staging": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              },
              "checks": {
                "properties": {
                  "host_service_binding": {
                    "properties": {
                      "outcome": {
                        "const": "pass"
                      }
                    }
                  },
                  "active_version": {
                    "properties": {
                      "outcome": {
                        "const": "pass"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "status": {
      "type": "object",
      "required": [
        "schema",
        "issuer",
        "enrollment_id",
        "assessment_id",
        "binding_id",
        "publisher_key_kid",
        "sequence",
        "assessment_status",
        "enrollment_status",
        "publisher_key_status",
        "reason_codes",
        "issued_at",
        "expires_at",
        "extensions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-status-v1"
        },
        "issuer": {
          "$ref": "#/definitions/httpsIdentifier"
        },
        "enrollment_id": {
          "$ref": "#/definitions/uuid"
        },
        "assessment_id": {
          "$ref": "#/definitions/uuid"
        },
        "binding_id": {
          "$ref": "#/definitions/hex256"
        },
        "publisher_key_kid": {
          "$ref": "#/definitions/base64url32"
        },
        "sequence": {
          "$ref": "#/definitions/positiveInteger"
        },
        "assessment_status": {
          "enum": ["current", "withdrawn"]
        },
        "enrollment_status": {
          "enum": ["active", "withdrawn"]
        },
        "publisher_key_status": {
          "enum": ["active", "compromised", "retired"]
        },
        "reason_codes": {
          "$ref": "#/definitions/reasonCodes"
        },
        "issued_at": {
          "$ref": "#/definitions/time"
        },
        "expires_at": {
          "$ref": "#/definitions/time"
        },
        "extensions": {
          "$ref": "#/definitions/extensions"
        }
      }
    },
    "keyDiscovery": {
      "type": "object",
      "required": ["schema", "host", "keys", "verifiers"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-key-discovery-v1"
        },
        "host": {
          "$ref": "#/definitions/host"
        },
        "keys": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/keyValidity"
          },
          "minItems": 1
        },
        "verifiers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/httpsIdentifier"
          },
          "$comment": "Untrusted HTTPS issuer discovery hints only. Never imports trust roots or enables a policy."
        }
      }
    },
    "compactJws": {
      "type": "string",
      "maxLength": 32768,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{85}[AQgw]$",
      "$comment": "Explicit exception to the 256-byte string limit. Header/payload parsing, base64url canonicality and signature verification are external."
    },
    "assessmentList": {
      "type": "object",
      "required": ["schema", "host", "environment", "assessments"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-assessment-list-v1"
        },
        "host": {
          "$ref": "#/definitions/host"
        },
        "environment": {
          "$ref": "#/definitions/environment"
        },
        "assessments": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/compactJws"
          }
        }
      },
      "$comment": "Aggregate decoded HTTP body limit: 524288 bytes, checked before JSON Schema validation; each compact JWS is at most 32768 ASCII bytes."
    },
    "enrollmentChallenge": {
      "type": "object",
      "required": [
        "schema",
        "issuer",
        "host",
        "publisher_id",
        "operator_id",
        "deployment_id",
        "provider",
        "service_id",
        "environment",
        "publisher_key_kid",
        "nonce",
        "issued_at",
        "expires_at"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-enrollment-challenge-v1"
        },
        "issuer": {
          "$ref": "#/definitions/httpsIdentifier"
        },
        "host": {
          "$ref": "#/definitions/host"
        },
        "publisher_id": {
          "$ref": "#/definitions/uuid"
        },
        "operator_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/httpsIdentifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployment_id": {
          "$ref": "#/definitions/uuid"
        },
        "provider": {
          "enum": ["fastly", "axum"]
        },
        "service_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonemptyText"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "$ref": "#/definitions/environment"
        },
        "publisher_key_kid": {
          "$ref": "#/definitions/base64url32"
        },
        "nonce": {
          "$ref": "#/definitions/base64url32"
        },
        "issued_at": {
          "$ref": "#/definitions/time"
        },
        "expires_at": {
          "$ref": "#/definitions/time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "fastly"
              }
            }
          },
          "then": {
            "properties": {
              "service_id": {
                "$ref": "#/definitions/nonemptyText"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "axum"
              }
            }
          },
          "then": {
            "properties": {
              "service_id": {
                "type": "null"
              },
              "environment": {
                "const": "development"
              }
            }
          }
        }
      ],
      "$comment": "issued_at < expires_at <= issued_at + 600 is checked outside JSON Schema."
    },
    "keyMetadata": {
      "type": "object",
      "required": [
        "schema",
        "kid",
        "jwk",
        "not_before",
        "not_after",
        "secret_name"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-key-metadata-v1"
        },
        "kid": {
          "$ref": "#/definitions/base64url32"
        },
        "jwk": {
          "$ref": "#/definitions/publicJwk"
        },
        "not_before": {
          "$ref": "#/definitions/time"
        },
        "not_after": {
          "$ref": "#/definitions/time"
        },
        "secret_name": {
          "type": "string",
          "pattern": "^ts-publisher-[a-z][a-z0-9-]{0,47}$"
        }
      },
      "$comment": "Read metadata at ts-publisher-key-<localname> in existing trusted_server_config; secret_name must equal ts-publisher-<same-localname> in existing trusted_server_secrets. Cross-entry equality is external."
    },
    "compactStatusJws": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{85}[AQgw]$",
      "$comment": "Explicit exception to the 256-byte string limit. Header/payload parsing, base64url canonicality and signature verification are external."
    },
    "keyHistory": {
      "type": "object",
      "required": ["schema", "host", "environment", "entries", "next_cursor"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-key-history-v1"
        },
        "host": {
          "$ref": "#/definitions/host"
        },
        "environment": {
          "$ref": "#/definitions/environment"
        },
        "entries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["assessment", "status"],
            "additionalProperties": false,
            "properties": {
              "assessment": {
                "$ref": "#/definitions/compactJws"
              },
              "status": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/compactStatusJws"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\x20-\\x7e]+$"
            }
          ]
        }
      },
      "$comment": "Untrusted transport of historical signed objects. Aggregate decoded HTTP body limit 524288 bytes is enforced externally before schema validation. Assessment JWS <=32768 ASCII bytes; status JWS <=8192 ASCII bytes. Pagination cursor is opaque printable ASCII; it confers no authority."
    },
    "policyCheck": {
      "type": "object",
      "required": ["requirement", "methods"],
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "enum": ["pass", "pass_or_not_assessed"]
        },
        "methods": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/nonemptyText"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "$comment": "methods null means the consumer's method allowlist governs this check; an array fixes the permitted methods."
    },
    "policyDocument": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "version",
        "checks",
        "build",
        "max_assessment_lifetime_seconds",
        "extensions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-policy-v1"
        },
        "id": {
          "$ref": "#/definitions/nonemptyText"
        },
        "version": {
          "$ref": "#/definitions/positiveInteger"
        },
        "checks": {
          "type": "object",
          "required": [
            "host_authorization",
            "key_possession",
            "host_service_binding",
            "active_version",
            "configuration"
          ],
          "additionalProperties": false,
          "properties": {
            "host_authorization": {
              "$ref": "#/definitions/policyCheck"
            },
            "key_possession": {
              "$ref": "#/definitions/policyCheck"
            },
            "host_service_binding": {
              "$ref": "#/definitions/policyCheck"
            },
            "active_version": {
              "$ref": "#/definitions/policyCheck"
            },
            "configuration": {
              "$ref": "#/definitions/policyCheck"
            }
          }
        },
        "build": {
          "type": "object",
          "required": [
            "assurance",
            "declared_methods",
            "fingerprint_methods",
            "artifact_methods"
          ],
          "additionalProperties": false,
          "properties": {
            "assurance": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": ["artifact_bound", "fingerprint_only", "declared"]
              }
            },
            "declared_methods": {
              "anyOf": [
                {
                  "type": "array",
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/nonemptyText"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "fingerprint_methods": {
              "anyOf": [
                {
                  "type": "array",
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/nonemptyText"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "artifact_methods": {
              "anyOf": [
                {
                  "type": "array",
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/nonemptyText"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "max_assessment_lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "extensions": {
          "$ref": "#/definitions/extensions"
        }
      },
      "$comment": "Canonical built-in policy document. The assessment policy.digest is SHA-256 of JCS(this document)."
    },
    "verifierMetadata": {
      "type": "object",
      "required": [
        "schema",
        "issuer",
        "publication_bases",
        "keys",
        "policies",
        "live_status"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-verifier-metadata-v1"
        },
        "issuer": {
          "$ref": "#/definitions/httpsIdentifier"
        },
        "publication_bases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/httpsIdentifier"
          }
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/keyValidity"
          }
        },
        "policies": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/policy"
          }
        },
        "live_status": {
          "type": "boolean"
        }
      },
      "$comment": "Unsigned convenience document at {issuer}/v1/issuer. Untrusted until confirmed out of band and pinned; never changes trust by itself."
    },
    "errorBody": {
      "type": "object",
      "required": ["schema", "error"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ts-publisher-error-v1"
        },
        "error": {
          "enum": [
            "invalid_request",
            "unknown_kid",
            "not_found",
            "method_not_allowed",
            "misdirected_request",
            "conflict",
            "rate_limited",
            "unavailable"
          ]
        }
      },
      "$comment": "Closed error body for publisher endpoints and registry read surfaces; at most 256 bytes."
    }
  }
}
