    "check": {
      "type": "object",
      "required": ["outcome", "method", "observed_at", "evidence_digest"],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": ["pass", "fail", "unavailable", "not_assessed"]
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonemptyText"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_digest": {
          "anyOf": [
            {
              "$ref": "#/definitions/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "observed_at": {
                "$ref": "#/definitions/time"
              },
              "evidence_digest": {
                "$ref": "#/definitions/digest"
              },
              "method": {
                "$ref": "#/definitions/nonemptyText"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "not_assessed"
              }
            }
          },
          "then": {
            "properties": {
              "method": {
                "type": "null"
              },
              "observed_at": {
                "type": "null"
              },
              "evidence_digest": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "method": {
                "$ref": "#/definitions/nonemptyText"
              }
            }
          }
        }
      ]
    },
    "checks": {
      "type": "object",
      "required": [
        "host_authorization",
        "key_possession",
        "host_service_binding",
        "active_version",
        "configuration"
      ],
      "additionalProperties": false,
      "properties": {
        "host_authorization": {
          "$ref": "#/definitions/check"
        },
        "key_possession": {
          "$ref": "#/definitions/check"
        },
        "host_service_binding": {
          "$ref": "#/definitions/check"
        },
        "active_version": {
          "$ref": "#/definitions/check"
        },
        "configuration": {
          "$ref": "#/definitions/check"
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "source_commit",
        "asset_name",
        "artifact_sha256",
        "verification_evidence_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "$comment": "Layer 1 owner/name identity; independently configured release eligibility remains mandatory."
        },
        "tag": {
          "$ref": "#/definitions/nonemptyText"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "asset_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^/\\\\\\s]+$",
          "$comment": "Simple asset basename; dot and dot-dot names are rejected.",
          "not": {
            "enum": [".", ".."]
          }
        },
        "artifact_sha256": {
          "$ref": "#/definitions/digest"
        },
        "verification_evidence_digest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "provenance",
        "assurance",
        "method",
        "artifact_sha256",
        "provider_files_hash",
        "release",
        "coverage"
      ],
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "enum": ["official", "custom", "unknown"]
        },
        "assurance": {
          "enum": ["artifact_bound", "fingerprint_only", "declared"]
        },
        "method": {
          "$ref": "#/definitions/nonemptyText"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "$ref": "#/definitions/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_files_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/definitions/release"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "enum": [
            "selected_executable_only",
            "provider_package_fingerprint",
            "declaration_only"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "official"
              }
            }
          },
          "then": {
            "properties": {
              "assurance": {
                "const": "artifact_bound"
              },
              "artifact_sha256": {
                "$ref": "#/definitions/digest"
              },
              "release": {
                "$ref": "#/definitions/release"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assurance": {
                "const": "artifact_bound"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_sha256": {
                "$ref": "#/definitions/digest"
              },
              "coverage": {
                "const": "selected_executable_only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assurance": {
                "const": "fingerprint_only"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_sha256": {
                "type": "null"
              },
              "release": {
                "type": "null"
              },
              "coverage": {
                "const": "provider_package_fingerprint"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assurance": {
                "const": "declared"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_sha256": {
                "type": "null"
              },
              "release": {
                "type": "null"
              },
              "coverage": {
                "const": "declaration_only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "custom"
              }
            }
          },
          "then": {
            "properties": {
              "release": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "reasonCodes": {
      "type": "array",
