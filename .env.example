# Trusted Server development environment variables
# Copy this file to .env.dev, .env.staging, or .env.production and fill in
# non-secret values. App-config secrets are key names in the pushed blob and
# their values belong in the platform secret store; see the configuration guide.
# For Axum runtime loading, export the config blob as:
# TRUSTED_SERVER_CONFIG_TRUSTED_SERVER_CONFIG_TRUSTED_SERVER_CONFIG=<blob-envelope-json>
# and export one secret per key name as:
# TRUSTED_SERVER_SECRET_TRUSTED_SERVER_SECRETS_<KEY_NAME>=<secret-value>
# The commented examples below are CLI overlays for ordinary fields only.
# Fastly example: map logical app-config secrets to physical `ts_secrets`.
# EDGEZERO__STORES__SECRETS__TRUSTED_SERVER_SECRETS__NAME=ts_secrets

# =============================================================================
# Publisher Settings
# =============================================================================
TRUSTED_SERVER__PUBLISHER__DOMAIN=publisher.com
TRUSTED_SERVER__PUBLISHER__COOKIE_DOMAIN=.publisher.com
TRUSTED_SERVER__PUBLISHER__ORIGIN_URL=https://origin.publisher.com

# =============================================================================
# Synthetic ID Settings
# =============================================================================
TRUSTED_SERVER__SYNTHETIC__COUNTER_STORE=counter_store
TRUSTED_SERVER__SYNTHETIC__OPID_STORE=opid_store
# Template variables: client_ip, user_agent, first_party_id, auth_user_id, publisher_domain, accept_language
TRUSTED_SERVER__SYNTHETIC__TEMPLATE={{ client_ip }}:{{ user_agent }}:{{ first_party_id }}

# =============================================================================
# Request Signing (optional)
# =============================================================================
TRUSTED_SERVER__REQUEST_SIGNING__ENABLED=false
# TRUSTED_SERVER__REQUEST_SIGNING__CONFIG_STORE_ID=<fastly-config-store-id>
# TRUSTED_SERVER__REQUEST_SIGNING__SECRET_STORE_ID=<fastly-secret-store-id>

# =============================================================================
# Response Headers (optional)
# =============================================================================
# TRUSTED_SERVER__RESPONSE_HEADERS__X_CUSTOM_HEADER=custom-value

# =============================================================================
# Integrations
# =============================================================================
# Which integrations run is set in the TOML file, in the section of each
# one's type, as `[auction] modules = ["prebid"]` and
# `[framework] module = "nextjs"`. There is no per-integration enabled flag.
# An overlay below changes a setting the file already carries, and it cannot
# add one the file leaves out or replace a list. An overlay names its section
# as the file writes it, so a section with a hyphen in its name, such as
# `[ad-tag]`, is set with `env 'NAME=value' command`, because a shell's
# `export` refuses the name.

# Prebid, the browser side. The Prebid Server endpoint belongs to a demand
# source, so its overlay is TRUSTED_SERVER__DEMAND__<NAME>__ENDPOINT.
# TRUSTED_SERVER__AUCTION__PREBID__ACCOUNT_ID=
# TRUSTED_SERVER__AUCTION__PREBID__TIMEOUT_MS=1000
# TRUSTED_SERVER__AUCTION__PREBID__DEBUG=false

# Next.js
# TRUSTED_SERVER__FRAMEWORK__NEXTJS__MAX_COMBINED_PAYLOAD_BYTES=10485760

# Didomi
# TRUSTED_SERVER__CMP__DIDOMI__SDK_ORIGIN=https://sdk.privacy-center.org
# TRUSTED_SERVER__CMP__DIDOMI__API_ORIGIN=https://api.privacy-center.org

# Permutive
# TRUSTED_SERVER__AUDIENCE__PERMUTIVE__ORGANIZATION_ID=
# TRUSTED_SERVER__AUDIENCE__PERMUTIVE__WORKSPACE_ID=
# TRUSTED_SERVER__AUDIENCE__PERMUTIVE__PROJECT_ID=

# Lockr
# TRUSTED_SERVER__IDENTITY__LOCKR__APP_ID=
# TRUSTED_SERVER__IDENTITY__LOCKR__CACHE_TTL_SECONDS=3600

# =============================================================================
# Rewrite Configuration (optional)
# =============================================================================
# Comma-separated list of domains to exclude from first-party rewriting
# TRUSTED_SERVER__REWRITE__EXCLUDE_DOMAINS=*.edgecompute.app
